# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-goes-here

# Random long string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# The admin's own login code (you choose this yourself, not generated by the app).
# Pick something only you know, e.g. a passphrase. Used to log into /admin.
ADMIN_CODE=change-me-admin-code
